   "source": [
    "import jax.numpy as jnp\n",
    "import e3nn_jax as e3nn\n",
    "\n",
    "point = jnp.array([\n",
    "    0.0, 1.0, 0.0,\n",
    "])\n",
    "\n",
    "e3nn.spherical_harmonics(\n",
    "    e3nn.Irreps(\"1o\"),\n",
    "    point,\n",
    "    normalize=True,\n",
    "    normalization=\"integral\"\n",
    ")"
   ]
  },
